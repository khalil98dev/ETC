<UserControl x:Class="SideBarWpf.ucMenueButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SideBarWpf"
             mc:Ignorable="d" 
             BorderThickness="0"
             d:DesignHeight="44" d:DesignWidth="228">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16"></ColumnDefinition>
            <ColumnDefinition Width="20"></ColumnDefinition>
            <ColumnDefinition Width="16"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="4" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent"
                Background="AliceBlue"
                >
            
        </Border>
        <Image Width="20" Height="20 " Grid.Column="1" Name="ImageSource" 
              Source="{Binding OImage, RelativeSource={RelativeSource AncestorType=UserControl}}"> </Image>
        <Label Grid.Column="3"  BorderThickness="0" x:Name="lblTitle" 
               Content="{Binding Title}"
               VerticalAlignment="Center"
                FontSize="20" 
               FontFamily="Roboto"
               > 
            
            
        </Label>

        
        
        
    </Grid>


</UserControl>
